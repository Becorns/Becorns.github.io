---
// 通过组件内 <style is:global> 注入全局样式，
// 避免在 frontmatter 中 import .css 触发 dev 环境下 oxc 的 TS 转换报错。
---
<style is:global>
/* ============ 全局变量 ============ */
:root {
  /* 默认深色主题 */
  --bg: #1e1e1e;
  --bg-sidebar: #181818;
  --bg-code: #262626;
  --bg-blockquote: #262626;
  --text: #d4d4d4;
  --text-muted: #9ca3af;
  --border: #2f2f2f;
  --accent: #818cf8;
  --accent-soft: rgba(129, 140, 248, 0.16);
  --hover: #2a2a2a;
  --sidebar-width: 280px;
  --toc-width: 250px;
  --radius: 6px;
  color-scheme: dark;
}

@media (prefers-color-scheme: light) {
  :root {
    --bg: #ffffff;
    --bg-sidebar: #f7f7f5;
    --bg-code: #f6f8fa;
    --bg-blockquote: #f6f8fa;
    --text: #24292f;
    --text-muted: #6e7781;
    --border: #e5e7eb;
    --accent: #4f46e5;
    --accent-soft: #eef2ff;
    --hover: #ececec;
    color-scheme: light;
  }
}

/* ============ 基础 ============ */
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family:
    -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
  font-size: 15px;
  line-height: 1.75;
  background: var(--bg);
  color: var(--text);
}

a {
  color: var(--accent);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

code {
  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
  font-size: 0.9em;
  background: var(--bg-code);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 0.1em 0.35em;
}

pre {
  background: #0d1117 !important;
  border-radius: var(--radius);
  padding: 14px 16px;
  overflow-x: auto;
  line-height: 1.6;
}

pre code {
  background: transparent;
  border: 0;
  padding: 0;
  font-size: 13px;
}

/* ============ 三栏布局 ============ */
.app {
  display: grid;
  grid-template-columns: var(--sidebar-width) minmax(0, 1fr) var(--toc-width);
  min-height: 100vh;
}

.app.no-right {
  grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
}

.sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  background: var(--bg-sidebar);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
}

.content {
  min-width: 0;
  padding: 32px 48px 96px;
}

.note,
.home {
  max-width: 780px;
  margin: 0 auto;
}

.right {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  border-left: 1px solid var(--border);
  padding: 24px 18px;
}

/* ============ 侧边栏 ============ */
.sidebar-header {
  padding: 16px 14px 10px;
  border-bottom: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--text);
  text-decoration: none;
}

.brand:hover {
  text-decoration: none;
}

.avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  flex-shrink: 0;
}

.brand-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.brand-name {
  font-size: 15px;
  font-weight: 700;
  line-height: 1.3;
}

.brand-sub {
  font-size: 12px;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tree-tools {
  display: flex;
  justify-content: flex-end;
  gap: 4px;
  margin-top: 8px;
}

.tree-tools button {
  font-size: 12px;
  color: var(--text-muted);
  background: transparent;
  border: 1px solid transparent;
  border-radius: 4px;
  padding: 2px 8px;
  cursor: pointer;
}

.tree-tools button:hover {
  color: var(--text);
  background: var(--hover);
  border-color: var(--border);
}

.tree {
  flex: 1;
  padding: 10px 8px;
  overflow-y: auto;
  font-size: 14px;
}

.tree-empty {
  color: var(--text-muted);
  font-size: 13px;
  padding: 8px 10px;
}

.tree details {
  margin: 0;
}

.tree summary {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  border-radius: var(--radius);
  cursor: pointer;
  user-select: none;
  list-style: none;
  color: var(--text);
}

.tree summary::-webkit-details-marker {
  display: none;
}

.tree summary:hover {
  background: var(--hover);
}

.tree .marker {
  color: var(--text-muted);
  flex-shrink: 0;
  font-size: 12px;
  width: 1em;
  display: inline-block;
  transition: transform 0.15s ease;
}

.tree details[open] > summary .marker {
  transform: rotate(90deg);
}

.dir-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dir-count {
  margin-left: auto;
  font-size: 11px;
  color: var(--text-muted);
  background: var(--hover);
  border-radius: 10px;
  padding: 0 7px;
  line-height: 1.5;
}

.dir-children {
  margin-left: 14px;
  border-left: 1px dashed var(--border);
  padding-left: 2px;
}

.tree .file {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  margin-left: 14px;
  border-radius: var(--radius);
  color: var(--text);
  text-decoration: none;
}

.tree .file:hover {
  background: var(--hover);
  text-decoration: none;
}

.tree .file.active {
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

.file-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-footer {
  padding: 10px 16px;
  border-top: 1px solid var(--border);
  font-size: 12px;
  color: var(--text-muted);
}

/* ============ 文章 ============ */
.breadcrumb {
  font-size: 13px;
  color: var(--text-muted);
  margin-bottom: 18px;
}

.breadcrumb a {
  color: var(--text-muted);
}

.breadcrumb a:hover {
  color: var(--accent);
}

.breadcrumb .sep {
  margin: 0 6px;
}

.note-header {
  margin-bottom: 28px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--border);
}

.note-header h1 {
  font-size: 28px;
  line-height: 1.35;
  margin: 0 0 10px;
}

.note-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  font-size: 13px;
  color: var(--text-muted);
}

.tag-list {
  display: flex;
  gap: 8px;
  list-style: none;
  margin: 0;
  padding: 0;
  flex-wrap: wrap;
}

.tag {
  color: var(--accent);
  font-size: 12px;
}

.note-desc {
  margin: 12px 0 0;
  color: var(--text-muted);
}

.note-footer {
  margin-top: 40px;
  padding-top: 14px;
  border-top: 1px solid var(--border);
  font-size: 13px;
  color: var(--text-muted);
}

.note-footer code {
  background: transparent;
  border: 0;
  padding: 0;
}

/* ============ 正文排版 ============ */
.prose h1,
.prose h2,
.prose h3,
.prose h4,
.prose h5 {
  scroll-margin-top: 20px;
  line-height: 1.4;
}

.prose h2 {
  font-size: 22px;
  margin: 32px 0 14px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border);
}

.prose h3 {
  font-size: 18px;
  margin: 26px 0 12px;
}

.prose h4 {
  font-size: 16px;
  margin: 20px 0 10px;
}

.prose p {
  margin: 12px 0;
}

.prose ul,
.prose ol {
  margin: 12px 0;
  padding-left: 26px;
}

.prose li {
  margin: 4px 0;
}

.prose blockquote {
  margin: 14px 0;
  padding: 8px 16px;
  border-left: 4px solid var(--accent);
  background: var(--bg-blockquote);
  border-radius: 0 var(--radius) var(--radius) 0;
  color: var(--text-muted);
}

.prose blockquote p {
  margin: 6px 0;
}

.prose table {
  border-collapse: collapse;
  margin: 16px 0;
  width: 100%;
  display: block;
  overflow-x: auto;
  font-size: 14px;
}

.prose th,
.prose td {
  border: 1px solid var(--border);
  padding: 7px 12px;
  text-align: left;
}

.prose th {
  background: var(--bg-sidebar);
  font-weight: 600;
}

.prose img {
  max-width: 100%;
  border-radius: var(--radius);
}

.prose hr {
  border: 0;
  border-top: 1px solid var(--border);
  margin: 24px 0;
}

/* 正文中的第一个一级标题由页面标题代替，隐藏以避免重复 */
.note-body > h1:first-child {
  display: none;
}

/* ============ 右侧目录 ============ */
.toc-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 12px;
}

.toc-tree,
.toc-children {
  list-style: none;
  margin: 0;
  padding: 0;
  font-size: 14px; /* 大纲放大 */
  line-height: 1.75;
}

.toc-node {
  margin: 0;
}

/* 一级以外的子级左侧留出缩进引导线，Obsidian 风格 */
.toc-children {
  margin-left: 12px;
  border-left: 1px solid var(--border);
  padding-left: 4px;
}

/* 可展开节点的折叠标记：只有有子标题的节点才显示 */
.toc-node summary {
  position: relative;
  padding: 2px 4px 2px 22px; /* 左侧预留三角列，与叶子对齐 */
  border-radius: 4px;
  cursor: pointer;
  user-select: none;
  list-style: none;
}

.toc-node summary::-webkit-details-marker {
  display: none;
}

.toc-node summary:hover {
  background: var(--hover);
}

.toc-node summary .marker {
  position: absolute;
  left: 6px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
  font-size: 10px;
  width: 10px;
  line-height: 1;
  transition: transform 0.15s ease;
}

.toc-node[open] > summary .marker {
  transform: translateY(-50%) rotate(90deg);
}

.toc-node summary:hover .marker {
  color: var(--accent);
}

.toc-node-label,
.toc-node-leaf {
  color: var(--text-muted);
  text-decoration: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.toc-node-label {
  padding: 0;
}

.toc-node-leaf {
  padding: 2px 4px 2px 22px; /* 与父节点文字(text)同样起点，保证同行对齐 */
  border-radius: 4px;
}

.toc-node-label:hover,
.toc-node-leaf:hover {
  color: var(--accent);
}

/* 当前浏览位置的标题：更强的高亮，方便定位 */
.toc-node-leaf.active,
.toc-node summary .toc-node-label.active {
  color: var(--accent);
  font-weight: 600;
  border-radius: 4px;
  box-shadow: inset 2px 0 0 var(--accent); /* 左侧强调条标记阅读位置 */
}

.toc-node-leaf.active,
.toc-node summary .toc-node-label.active {
  background: var(--accent-soft);
}

/* 展开的父节点名称加粗以突显所在章节 */
.toc-node[open] > summary .toc-node-label {
  font-weight: 600;
}

.toc-empty {
  font-size: 13px;
  color: var(--text-muted);
}

/* ============ 首页 ============ */
.home {
  padding: 8px 0;
}

.home-head {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 24px 0 18px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 18px;
}

.home-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  flex-shrink: 0;
}

.home-head h1 {
  font-size: 20px;
  font-weight: 700;
  margin: 0 0 4px;
}

.home-head p {
  margin: 0;
  font-size: 13px;
  color: var(--text-muted);
}

/* —— 首页全量目录树（Word 大纲视图）—— */
.home-tree {
  max-width: 820px;
}

.home-tree .muted {
  padding: 12px 0;
}

.ht-dir {
  margin: 0;
}

.ht-dir summary {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 8px;
  border-radius: 4px;
  cursor: pointer;
  user-select: none;
  list-style: none;
  font-weight: 600;
  color: var(--text);
}

.ht-dir summary::-webkit-details-marker {
  display: none;
}

.ht-dir summary:hover {
  background: var(--hover);
}

.ht-marker {
  color: var(--text-muted);
  flex-shrink: 0;
  font-size: 10px;
  width: 1em;
  transition: transform 0.15s ease;
}

.ht-dir[open] > summary .ht-marker {
  transform: rotate(90deg);
}

.ht-dir-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ht-count {
  margin-left: auto;
  font-size: 11px;
  color: var(--text-muted);
  background: var(--hover);
  border-radius: 10px;
  padding: 0 8px;
  line-height: 1.6;
}

.ht-children {
  margin-left: 14px;
  border-left: 1px solid var(--border);
  padding-left: 4px;
}

.ht-file {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  margin-left: 14px;
  border-radius: 4px;
}

.ht-file:hover {
  background: var(--hover);
}

.ht-file a {
  color: var(--text);
  font-size: 14px;
  text-decoration: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ht-file a:hover {
  color: var(--accent);
  text-decoration: underline;
}

/* 占位以保证叶子与父级文字对齐 */
.ht-marker-spacer {
  width: 1em;
  flex-shrink: 0;
}

.muted {
  color: var(--text-muted);
}

/* 右侧“最近更新”卡片 */
.right-card h3 {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin: 0 0 12px;
}

.recent-list {
  list-style: none;
  margin: 0;
  padding: 0;
  font-size: 13px;
}

.recent-list li {
  margin: 0 0 10px;
}

.recent-list a {
  display: block;
  color: var(--text);
  line-height: 1.4;
}

.recent-list a:hover {
  color: var(--accent);
}

.recent-date {
  display: block;
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 1px;
}

/* ============ 移动端 ============ */
.menu-btn {
  display: none;
  position: fixed;
  top: 10px;
  left: 10px;
  z-index: 200;
  width: 38px;
  height: 38px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--bg);
  color: var(--text);
  font-size: 18px;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.backdrop {
  display: none;
}

@media (max-width: 1100px) {
  .app,
  .app.no-right {
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
  }

  .right {
    display: none;
  }
}

@media (max-width: 860px) {
  .app,
  .app.no-right {
    grid-template-columns: minmax(0, 1fr);
  }

  .menu-btn {
    display: block;
  }

  .sidebar {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    width: min(84vw, 300px);
    z-index: 150;
    transform: translateX(-105%);
    transition: transform 0.22s ease;
    box-shadow: 4px 0 20px rgba(0, 0, 0, 0.18);
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .backdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 140;
    background: rgba(0, 0, 0, 0.35);
  }

  .backdrop[hidden] {
    display: none;
  }

  .content {
    padding: 20px 18px 64px;
  }
}
</style>
